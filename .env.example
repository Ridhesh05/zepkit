# ── Ollama (runs natively on host) ──
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:latest
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ── Kafka ──
KAFKA_BROKERS=localhost:9092
KAFKA_PRODUCT_TOPIC=product.events
KAFKA_CLIENT_ID=zepkit

# ── TypeSense ──
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=zepkit-dev-key
TYPESENSE_COLLECTION=products

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── MongoDB ──
MONGO_URI=mongodb://localhost:27017
MONGO_DB=zepkit

# ── Service ports ──
AI_SERVICE_PORT=4001
API_GATEWAY_PORT=4000

# ── Admin RBAC ──
ADMIN_KEY=zepkit-admin-2024
